module load nvhpc/25.3
make clean
make
for tt_opt in  512 1024 2048 4096 8192 16384 32768; do 
    for t_opt in 32 64 128 256 512 1024 2048 4096 8192 16384 32768; do
        ./triad-gpu-offload_gpu-init.out 30 ${t_opt} ${tt_opt} > "./tests/teams_${t_opt}_${tt_opt}.csv"
    done
done





