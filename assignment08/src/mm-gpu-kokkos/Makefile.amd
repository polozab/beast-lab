# Compiler for AMD GPUs
CXX=hipcc
CC=hipcc

# Target AMD GPU architecture (adjust as needed: gfx90a = MI250, gfx942 = MI300)
AMD_ARCH=gfx90a

# Compilation flags
CPPFLAGS=-g -O3 -std=c++20 -fopenmp \
  -I$(KOKKOS_ROOT)/include \
  -DKOKKOS_ENABLE_HIP \
  -DKOKKOS_ARCH_$(AMD_ARCH) \
  -Wno-deprecated-declarations -Wno-tautological-constant-compare -Wno-unknown-attributes -ffp-model=precise

# Linker flags
LDFLAGS=$(CPPFLAGS)

# Libraries
LDLIBS= \
  -L$(KOKKOS_ROOT)/lib64 \
  -lkokkoscore -lkokkossimd -lkokkoscontainers \
  -lpthread -ldl

# Source and object files
SRCS=hello_kokkos.cpp kokkos_mm.cpp kokkos_device_props_hip.cpp
OBJS=$(SRCS:.cpp=.o)

# Build all targets
all: hello_kokkos kokkos_mm kokkos_device_props_hip

hello_kokkos: hello_kokkos.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

kokkos_mm: kokkos_mm.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

kokkos_device_props_hip: kokkos_device_props_hip.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

# Run both executables
run_all: all
	./hello_kokkos
	./kokkos_mm 16
	./kokkos_device_props_hip

# Cleanup
clean:
	rm -f $(OBJS)

distclean: clean
	rm -f hello_kokkos kokkos_mm kokkos_device_props_hip

