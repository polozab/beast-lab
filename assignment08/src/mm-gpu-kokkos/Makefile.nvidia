CXX=$(KOKKOS_ROOT)/bin/nvcc_wrapper
CC=gcc

# Kokkos architecture flag for NVIDIA Grace Hopper (SM90 = 90)
KOKKOS_ARCH=HOPPER90

CPPFLAGS=-arch=sm_90 -g -O3 -std=c++20 \
  -I$(KOKKOS_ROOT)/include \
  -fopenmp \
  -DKOKKOS_ENABLE_CUDA \
  -DKOKKOS_ARCH_$(KOKKOS_ARCH) \
  --expt-extended-lambda

LDFLAGS=$(CPPFLAGS)
LDLIBS= \
  -L$(KOKKOS_ROOT)/lib \
  -lkokkoscore -lkokkossimd -lkokkoscontainers \
  -L$(CUDA_ROOT)/lib64 -lcuda -lcudart \
  -lpthread -ldl

SRCS=./hello_kokkos.cpp ./kokkos_mm.cpp kokkos_device_props_cuda.cpp
OBJS=$(SRCS:.cpp=.o)

all: hello_kokkos kokkos_mm kokkos_device_props_cuda

hello_kokkos: ./hello_kokkos.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

kokkos_mm: ./kokkos_mm.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

kokkos_device_props_cuda: ./kokkos_device_props_cuda.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LDLIBS)

run_all: all
	./hello_kokkos
	./kokkos_mm 16
	./kokkos_device_props_cuda

clean:
	rm -f $(OBJS)

distclean: clean
	rm -f hello_kokkos kokkos_mm kokkos_device_props_cuda
